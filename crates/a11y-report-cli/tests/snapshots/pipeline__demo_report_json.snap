      "title": "Meaningful sequence",
      "why": "Reading order depends on meaning, not only on position: swipe through the screen with TalkBack."
    },
    {
      "criterion": "wcag-1.3.4",
      "reference": "WCAG 1.3.4 · EN 301 549 11.1.3.4",
      "title": "Orientation",
      "why": "The app must work in portrait and landscape unless an orientation is essential."
    },
    {
      "criterion": "wcag-1.4.1",
      "reference": "WCAG 1.4.1 · EN 301 549 11.1.4.1",
      "title": "Use of color",
      "why": "Information must not be conveyed by colour alone (errors, states, charts)."
    },
    {
      "criterion": "wcag-1.4.3",
      "reference": "WCAG 1.4.3 · EN 301 549 11.1.4.3",
      "title": "Contrast (minimum)",
      "why": "Text over images or gradients is reported with low confidence and must be checked by eye."
    },
    {
      "criterion": "wcag-1.4.4",
      "reference": "WCAG 1.4.4 · EN 301 549 11.1.4.4",
      "title": "Resize text",
      "why": "Set the system font size to 200% and check that no text is truncated or overlapping."
    },
    {
      "criterion": "wcag-1.4.11",
      "reference": "WCAG 1.4.11 · EN 301 549 11.1.4.11",
      "title": "Non-text contrast",
      "why": "Icons, input borders and focus indicators need a 3:1 contrast with their surroundings."
    },
    {
      "criterion": "wcag-2.1.1",
      "reference": "WCAG 2.1.1 · EN 301 549 11.2.1.1",
      "title": "Keyboard",
      "why": "Every action must be reachable with an external keyboard or Switch Access."
    },
    {
      "criterion": "wcag-2.2.2",
      "reference": "WCAG 2.2.2 · EN 301 549 11.2.2.2",
      "title": "Pause, stop, hide",
      "why": "Carousels and animations that last more than 5 seconds must be pausable."
    },
    {
      "criterion": "wcag-2.4.3",
      "reference": "WCAG 2.4.3 · EN 301 549 11.2.4.3",
      "title": "Focus order",
      "why": "Focus must move in an order that preserves meaning, including after dialogs open and close."
    },
    {
      "criterion": "wcag-2.4.6",
      "reference": "WCAG 2.4.6 · EN 301 549 11.2.4.6",
      "title": "Headings and labels",
      "why": "Only duplicated labels are detected: whether each label describes its purpose needs human judgement."
    },
    {
      "criterion": "wcag-2.4.7",
      "reference": "WCAG 2.4.7 · EN 301 549 11.2.4.7",
      "title": "Focus visible",
      "why": "With a keyboard, the focused element must be visibly highlighted."
    },
    {
      "criterion": "wcag-2.5.1",
      "reference": "WCAG 2.5.1 · EN 301 549 11.2.5.1",
      "title": "Pointer gestures",
      "why": "Multi-finger or path-based gestures need a single-tap alternative."
    },
    {
      "criterion": "wcag-2.5.3",
      "reference": "WCAG 2.5.3 · EN 301 549 11.2.5.3",
      "title": "Label in name",
      "why": "The accessible name must contain the visible label (voice control users say what they see)."
    },
    {
      "criterion": "wcag-2.5.8",
      "reference": "WCAG 2.5.8",
      "title": "Target size (minimum)",
      "why": "The spacing exception (small targets far enough from others) is not evaluated."
    },
    {
      "criterion": "wcag-3.3.1",
      "reference": "WCAG 3.3.1 · EN 301 549 11.3.3.1",
      "title": "Error identification",
      "why": "Form errors must be described in text and announced to TalkBack."
    },
    {
      "criterion": "wcag-3.3.2",
      "reference": "WCAG 3.3.2 · EN 301 549 11.3.3.2",
      "title": "Labels or instructions",
      "why": "Input fields need a persistent label, not only a placeholder that disappears."
    },
    {
      "criterion": "wcag-4.1.2",
      "reference": "WCAG 4.1.2 · EN 301 549 11.4.1.2",
      "title": "Name, role, value",
      "why": "Roles and states (selected, expanded, checked) must be checked with TalkBack."
    },
    {
      "criterion": "wcag-4.1.3",
      "reference": "WCAG 4.1.3 · EN 301 549 11.4.1.3",
      "title": "Status messages",
      "why": "Snackbars, toasts and loading states must be announced without moving focus."
    }
  ],
  "known_limitations": [
    "WCAG 2.5.8: the spacing exception is not evaluated.",
    "Contrast: bold text cannot be detected, so the 14 pt bold large-text rule is not applied.",
    "Contrast: text over images or gradients is reported with low confidence and never fails a criterion.",
    "Missing names on text fields have low confidence: hint and labelFor are not visible in uiautomator dumps.",
    "Only captured screens are audited; screens that were not captured are not checked.",
    "EN 301 549 references use the chapter 11 clause matching each WCAG criterion."
  ]
}
